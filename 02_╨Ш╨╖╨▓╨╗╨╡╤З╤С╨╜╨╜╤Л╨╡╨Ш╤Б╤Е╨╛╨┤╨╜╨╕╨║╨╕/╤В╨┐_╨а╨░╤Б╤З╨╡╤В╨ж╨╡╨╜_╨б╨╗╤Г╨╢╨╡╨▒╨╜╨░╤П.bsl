Функция ПолучитьКоэфДорожныхРасходов(СкладТемп, ДатаТемп)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КоэффициентыДорожныхРасходовСрезПоследних.Коэффициент КАК Коэффициент,
		|	КоэффициентыДорожныхРасходовСрезПоследних.РасчетПоТаблице КАК РасчетПоТаблице
		|ИЗ
		|	РегистрСведений.КоэффициентыДорожныхРасходов.СрезПоследних(&Период, Склад = &Склад) КАК КоэффициентыДорожныхРасходовСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", ДатаТемп);
	Запрос.УстановитьПараметр("Склад", СкладТемп);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СтруктураВозврата = Новый Структура;
	// По умолчанию считаем по таблице РегистрСведений.ЦенаДопРасходов,
	// если не задано в коэфициентах
	СтруктураВозврата.Вставить("Коэффициент", 0);
	СтруктураВозврата.Вставить("РасчетПоТаблице", Истина);
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СтруктураВозврата.Коэффициент   = ВыборкаДетальныеЗаписи.Коэффициент;
		СтруктураВозврата.РасчетПоТаблице		= ВыборкаДетальныеЗаписи.РасчетПоТаблице;
	КонецЕсли;
	
	Возврат  СтруктураВозврата;
	
КонецФункции	

Функция ПолучитьСтавкуЗаПресс(СкладТемп, ДатаТемп, ТипУпаковки, АдресМагазина)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тп_СтавкиЗаПрессСрезПоследних.Склад КАК Склад,
		|	тп_СтавкиЗаПрессСрезПоследних.Ставка КАК СтавкаЗаПресс,
		|	тп_СтавкиЗаПрессСрезПоследних.ВалютаСтавки КАК ВалютаСтавки,
		|	0 КАК Приоритет
		|ИЗ
		|	РегистрСведений.тп_СтавкиЗаПресс.СрезПоследних(
		|			&Период,
		|			Склад = &Склад
		|				И ТипУпаковки = &ТипУпаковки
		|				И Магазин = &АдресМагазина) КАК тп_СтавкиЗаПрессСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	тп_СтавкиЗаПрессСрезПоследних.Склад,
		|	тп_СтавкиЗаПрессСрезПоследних.Ставка,
		|	тп_СтавкиЗаПрессСрезПоследних.ВалютаСтавки,
		|	1
		|ИЗ
		|	РегистрСведений.тп_СтавкиЗаПресс.СрезПоследних(
		|			&Период,
		|			Склад = &Склад
		|				И ТипУпаковки = &ТипУпаковки
		|				И Магазин = &ПустойМагазин) КАК тп_СтавкиЗаПрессСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
	
	Запрос.УстановитьПараметр("Период", ДатаТемп);
	Запрос.УстановитьПараметр("Склад", СкладТемп);
	Запрос.УстановитьПараметр("ТипУпаковки", ТипУпаковки); 
	Запрос.УстановитьПараметр("АдресМагазина", АдресМагазина); 
	Запрос.УстановитьПараметр("ПустойМагазин", Справочники.тп_АдресаМагазинов.ПустаяСсылка());


	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("СтавкаЗаПресс", 0);
	СтруктураВозврата.Вставить("ВалютаСтавки", Справочники.Валюты.ПустаяСсылка());
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СтруктураВозврата.СтавкаЗаПресс = ВыборкаДетальныеЗаписи.СтавкаЗаПресс;
		СтруктураВозврата.ВалютаСтавки	= ВыборкаДетальныеЗаписи.ВалютаСтавки;
	КонецЕсли;
	
	Возврат  СтруктураВозврата;
	
КонецФункции	

Процедура РасчетДопРасходовЗаДоставку(ДанныеДляРасчета) Экспорт
	
	Если ДанныеДляРасчета.ВидОперации = Перечисления.тп_ВидОперацииПриемТовара.ПриемПочтыСтационарный 
			ИЛИ ДанныеДляРасчета.НеНачислятьДопРасход Тогда
		ДанныеДляРасчета.СуммаДопРасходовЗаДоставку = 0;
		Возврат;
	КонецЕсли;
	
	НастройкиБазы = РегистрыСведений.тп_НастройкиБазы.ПолучитьНастройкиБазы();
	
	Если ПроверкаНаличияЦеныДляКлиента(ДанныеДляРасчета) И НЕ НастройкиБазы.ОтключитьПроверкуДоговорнойПартииДляДопРасходов Тогда
		ДанныеДляРасчета.СуммаДопРасходовЗаДоставку = 0;
		Возврат	
	КонецЕсли;
	
	
	
	КоэфДорРасходов = ПолучитьКоэфДорожныхРасходов(ДанныеДляРасчета.Склад, ДанныеДляРасчета.Дата);
	
	Если ДанныеДляРасчета.ОбщийОбъем > 0 и ДанныеДляРасчета.ОбщийВес > 0 Тогда
		ДанныеДляРасчета.СреднийВес	= Окр(ДанныеДляРасчета.ОбщийВес / ДанныеДляРасчета.ОбщийОбъем, 2);
		СтруктураЦены = ПолучитьСуммуДопРасходовПоВесу(ДанныеДляРасчета, ДанныеДляРасчета.СреднийВес);
		
		Если КоэфДорРасходов.РасчетПоТаблице Тогда
			Если СтруктураЦены.ПоВесу Тогда
				ДанныеДляРасчета.СуммаДопРасходовЗаДоставку	= ДанныеДляРасчета.ОбщийВес * СтруктураЦены.Цена/1000;
			Иначе
				ДанныеДляРасчета.СуммаДопРасходовЗаДоставку	= ДанныеДляРасчета.ОбщийОбъем * СтруктураЦены.Цена;
			КонецЕсли;
			 
		Иначе
			ДанныеДляРасчета.СуммаДопРасходовЗаДоставку	= ДанныеДляРасчета.ОбщийВес * КоэфДорРасходов.Коэффициент;
			ДанныеДляРасчета.СуммаДопРасходовЗаДоставкуНазначил  = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;	
		
		Если ДанныеДляРасчета.СуммаДопРасходовЗаДоставку <> 0 Тогда
			ДанныеДляРасчета.СуммаДопРасходовЗаДоставкуНазначил  = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;	
	Иначе
		ДанныеДляРасчета.СуммаДопРасходовЗаДоставку = 0;
	КонецЕсли;
	
КонецПроцедуры	

Процедура РасчетСтавкиЗаПресс(ДанныеДляРасчета) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДанныеДляРасчета.АдресМагазина) Тогда
		ДанныеДляРасчета.СуммаДопРасходовЗаПресс = 0;
		ДанныеДляРасчета.ВалютаСтавкиЗаПресс     = Справочники.Валюты.ПустаяСсылка();
		Возврат;
	КонецЕсли;
	
	Если ДанныеДляРасчета.АдресМагазина.АдресПоставщика И ДанныеДляРасчета.КоличествоМест > 0 Тогда
		СтруктураСтавки = ПолучитьСтавкуЗаПресс(ДанныеДляРасчета.Склад, ДанныеДляРасчета.Дата, ДанныеДляРасчета.ТипУпаковки, ДанныеДляРасчета.АдресМагазина);
		ДанныеДляРасчета.СуммаДопРасходовЗаПресс = ДанныеДляРасчета.КоличествоМест * СтруктураСтавки.СтавкаЗаПресс;
		ДанныеДляРасчета.СтавкаЗаПресс =  СтруктураСтавки.СтавкаЗаПресс;
		ДанныеДляРасчета.ВалютаСтавкиЗаПресс     = СтруктураСтавки.ВалютаСтавки;
	Иначе
		ДанныеДляРасчета.СуммаДопРасходовЗаПресс = 0;
		ДанныеДляРасчета.СтавкаЗаПресс =  0;
		ДанныеДляРасчета.ВалютаСтавкиЗаПресс     = Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;	
	
КонецПроцедуры	

Процедура РасчетСреднейЦены(ДанныеДляРасчета, ЭтоКалькуляция = Ложь, ЗаполнятьТоварыПриКалькуляции = Ложь, РасчетПоНовомуДляКалькуляции = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ДанныеДляРасчета.ВидОперации = Перечисления.тп_ВидОперацииПриемТовара.ПриемПочты Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеДляРасчета.ЦенаВручную ИЛИ ДанныеДляРасчета.СуммаВручную Тогда
		ОбработатьИзменениеЦеныВручную(ДанныеДляРасчета, ЭтоКалькуляция, ЗаполнятьТоварыПриКалькуляции);
		Возврат;
	КонецЕсли;
	
	ДанныеДляРасчета.ЦенаЗаТонну	= 0;
	ДанныеДляРасчета.ЦенаЗаКуб		= 0;
	ДанныеДляРасчета.Сумма			= 0;
	
	ДанныеДляРасчета.СуммаБренд	    = 0;
	ДанныеДляРасчета.СуммаZ	        = 0;
	
	Если НЕ ЭтоКалькуляция Тогда
		ТаблицаТоваров = ДанныеДляРасчета.Товары.Выгрузить();
		ТаблицаТоваров.ЗаполнитьЗначения(0, "Сумма");
		ДанныеДляРасчета.Товары.Загрузить(ТаблицаТоваров);
		
		ОбщийОбъем		= 0;
		Для Каждого текСтрока из ТаблицаТоваров Цикл
			Если не (текСтрока.ВозвратТовара или ДанныеДляРасчета.ПолныйВозврат) Тогда
				ОбщийОбъем		= ОбщийОбъем + текСтрока.объем;
			КонецЕсли;	
		КонецЦикла;
		
		ДанныеДляРасчета.ОбщийОбъем = ОбщийОбъем;
	ИначеЕсли ЗаполнятьТоварыПриКалькуляции Тогда
		ТаблицаТоваров = ДанныеДляРасчета.Товары;
		ТаблицаТоваров.ЗаполнитьЗначения(0, "Сумма");
		
		ОбщийОбъем		= 0;
		Для Каждого текСтрока из ТаблицаТоваров Цикл
			Если не (текСтрока.ВозвратТовара или ДанныеДляРасчета.ПолныйВозврат) Тогда
				ОбщийОбъем		= ОбщийОбъем + текСтрока.объем;
			КонецЕсли;	
		КонецЦикла;
		
		ДанныеДляРасчета.ОбщийОбъем = ОбщийОбъем;
	КонецЕсли;
	
	Если НЕ (ЗначениеЗаполнено(ДанныеДляРасчета.ОбщийОбъем) и ЗначениеЗаполнено(ДанныеДляРасчета.ОбщийВес)) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеДляРасчета.ВидТовара) Тогда
		Возврат;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ДанныеДляРасчета.ТипУпаковки) Тогда
		Возврат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДанныеДляРасчета.ОбщийОбъем) Тогда
		ДанныеДляРасчета.СреднийВес	= Окр(ДанныеДляРасчета.ОбщийВес / ДанныеДляРасчета.ОбщийОбъем,2);
	КонецЕсли;	
	
	Попытка
		ДанныеДляРасчета.ВидТарифаНаПеревозку = ПолучитьВидТарифаПеревозок(ДанныеДляРасчета.ВидОперации); 
	Исключение
	КонецПопытки;	
	
	ДанныеДляРасчета.СуммаДопРасходовЗаДоставку = 0;
	Если (НЕ ДанныеДляРасчета.ВидОперации = Перечисления.тп_ВидОперацииПриемТовара.ПриемПочтыСтационарный) 
		И (НЕ ДанныеДляРасчета.НеНачислятьДопРасход) Тогда
		РасчетСтавкиЗаПресс(ДанныеДляРасчета);
	Иначе
		ДанныеДляРасчета.СуммаДопРасходовЗаПресс = 0;
	КонецЕсли;
	
	РасчетЦенПоНовому = Константы.тп_РасчетЦенПоНовому.Получить(); 
	
	
	Если РасчетЦенПоНовому или РасчетПоНовомуДляКалькуляции Тогда
		// Перписать
		СтруктураЦенПоНовому = ПолучитьЦеныПоНовому(ДанныеДляРасчета); 
		РасчетПоНовому = СтруктураЦенПоНовому.ЦенаНаПеревозкуУстановлена И СтруктураЦенПоНовому.ЦенаНаРастаможкуУстановлена;     
		
		Если РасчетПоНовому Тогда
			РасчетСреднейЦеныПоНовому(ДанныеДляРасчета, ЭтоКалькуляция, ЗаполнятьТоварыПриКалькуляции);
		Иначе
			РасчетДопРасходовЗаДоставку(ДанныеДляРасчета);
			РасчетСреднейЦеныПоСтарому(ДанныеДляРасчета, ЭтоКалькуляция, ЗаполнятьТоварыПриКалькуляции);  
			// пока так
			Возврат;
		КонецЕсли;	
	Иначе
		РасчетДопРасходовЗаДоставку(ДанныеДляРасчета);
		РасчетСреднейЦеныПоСтарому(ДанныеДляРасчета, ЭтоКалькуляция, ЗаполнятьТоварыПриКалькуляции);  
		// пока так
		Возврат;
	Конецесли;	
	
	РаспределитьСуммыПоТоварам(ДанныеДляРасчета, ЭтоКалькуляция, ЗаполнятьТоварыПриКалькуляции);
	
КонецПроцедуры    

Процедура ПолучитьРегистраторРасчетаЦен(ДанныеДляРасчета, ЭтоКалькуляция = Ложь, ЗаполнятьТоварыПриКалькуляции = Ложь, РасчетПоНовомуДляКалькуляции = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДанныеДляРасчета.Вставить("ДокументУстановкаЦен");
	
	Если ДанныеДляРасчета.ВидОперации = Перечисления.тп_ВидОперацииПриемТовара.ПриемПочты Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеДляРасчета.ЦенаВручную ИЛИ ДанныеДляРасчета.СуммаВручную Тогда
		ОбработатьИзменениеЦеныВручную(ДанныеДляРасчета, ЭтоКалькуляция, ЗаполнятьТоварыПриКалькуляции);
		Возврат;
	КонецЕсли;
	
	ДанныеДляРасчета.ЦенаЗаТонну	= 0;
	ДанныеДляРасчета.ЦенаЗаКуб		= 0;
	ДанныеДляРасчета.Сумма			= 0;
	
	ДанныеДляРасчета.СуммаБренд	    = 0;
	ДанныеДляРасчета.СуммаZ	        = 0;
	
	Если НЕ ЭтоКалькуляция Тогда
		ТаблицаТоваров = ДанныеДляРасчета.Товары.Выгрузить();
		ТаблицаТоваров.ЗаполнитьЗначения(0, "Сумма");
		ДанныеДляРасчета.Товары.Загрузить(ТаблицаТоваров);
		
		ОбщийОбъем		= 0;
		Для Каждого текСтрока из ТаблицаТоваров Цикл
			Если не (текСтрока.ВозвратТовара или ДанныеДляРасчета.ПолныйВозврат) Тогда
				ОбщийОбъем		= ОбщийОбъем + текСтрока.объем;
			КонецЕсли;	
		КонецЦикла;
		
		ДанныеДляРасчета.ОбщийОбъем = ОбщийОбъем;
	ИначеЕсли ЗаполнятьТоварыПриКалькуляции Тогда
		ТаблицаТоваров = ДанныеДляРасчета.Товары;
		ТаблицаТоваров.ЗаполнитьЗначения(0, "Сумма");
		
		ОбщийОбъем		= 0;
		Для Каждого текСтрока из ТаблицаТоваров Цикл
			Если не (текСтрока.ВозвратТовара или ДанныеДляРасчета.ПолныйВозврат) Тогда
				ОбщийОбъем		= ОбщийОбъем + текСтрока.объем;
			КонецЕсли;	
		КонецЦикла;
		
		ДанныеДляРасчета.ОбщийОбъем = ОбщийОбъем;
	КонецЕсли;
	
	Если НЕ (ЗначениеЗаполнено(ДанныеДляРасчета.ОбщийОбъем) и ЗначениеЗаполнено(ДанныеДляРасчета.ОбщийВес)) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеДляРасчета.ВидТовара) Тогда
		Возврат;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ДанныеДляРасчета.ТипУпаковки) Тогда
		Возврат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДанныеДляРасчета.ОбщийОбъем) Тогда
		ДанныеДляРасчета.СреднийВес	= Окр(ДанныеДляРасчета.ОбщийВес / ДанныеДляРасчета.ОбщийОбъем,2);
	КонецЕсли;	
	
	Попытка
		ДанныеДляРасчета.ВидТарифаНаПеревозку = ПолучитьВидТарифаПеревозок(ДанныеДляРасчета.ВидОперации); 
	Исключение
	КонецПопытки;	
	
	ДанныеДляРасчета.СуммаДопРасходовЗаДоставку = 0;
	Если (НЕ ДанныеДляРасчета.ВидОперации = Перечисления.тп_ВидОперацииПриемТовара.ПриемПочтыСтационарный) 
		И (НЕ ДанныеДляРасчета.НеНачислятьДопРасход) Тогда
		РасчетСтавкиЗаПресс(ДанныеДляРасчета);
	Иначе
		ДанныеДляРасчета.СуммаДопРасходовЗаПресс = 0;
	КонецЕсли;
	
	РасчетЦенПоНовому = Константы.тп_РасчетЦенПоНовому.Получить(); 
	
	
	Если РасчетЦенПоНовому или РасчетПоНовомуДляКалькуляции Тогда
		// Перписать
		СтруктураЦенПоНовому = ПолучитьЦеныПоНовому(ДанныеДляРасчета); 
		РасчетПоНовому = СтруктураЦенПоНовому.ЦенаНаПеревозкуУстановлена И СтруктураЦенПоНовому.ЦенаНаРастаможкуУстановлена;     
		
		Если РасчетПоНовому Тогда
			РасчетСреднейЦеныПоНовому(ДанныеДляРасчета, ЭтоКалькуляция, ЗаполнятьТоварыПриКалькуляции);
		Иначе
			РасчетДопРасходовЗаДоставку(ДанныеДляРасчета);
			РасчетСреднейЦеныПоСтарому(ДанныеДляРасчета, ЭтоКалькуляция, ЗаполнятьТоварыПриКалькуляции);  
			// пока так
			Возврат;
		КонецЕсли;	
	Иначе
		РасчетДопРасходовЗаДоставку(ДанныеДляРасчета);
		РасчетСреднейЦеныПоСтарому(ДанныеДляРасчета, ЭтоКалькуляция, ЗаполнятьТоварыПриКалькуляции);  
		// пока так
		Возврат;
	Конецесли;	
	
	РаспределитьСуммыПоТоварам(ДанныеДляРасчета, ЭтоКалькуляция, ЗаполнятьТоварыПриКалькуляции);
	
КонецПроцедуры    


