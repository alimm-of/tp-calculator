// Внешняя обработка "ВыгрузкаЦенJSON" — для базы «Транспортные перевозки».
// Выгружает актуальные (срез последних) цены/тарифы в нейтральный JSON-файл,
// который импортирует Python-калькулятор (tp_calc/importer.py).
//
// Имена ключей JSON СОВПАДАЮТ с колонками schema.sql калькулятора.
// Ссылочные поля (Клиент, ВидТовара, Склад, ...) выгружаются как СТРОКА-идентификатор:
// по умолчанию — Код справочника (для перечислений — имя значения). Тот же идентификатор
// пользователь вводит в калькуляторе. При необходимости замените на УникальныйИдентификатор.

&НаКлиенте
Процедура ВыгрузитьВJSON(Команда)
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект);
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Куда сохранить цены (JSON)";
	Диалог.Фильтр = "JSON (*.json)|*.json";
	Диалог.Расширение = "json";
	Диалог.ИмяФайла = "ЦеныТП_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd") + ".json";
	Диалог.Показать(ОписаниеОповещения);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(Файлы, ДопП) Экспорт
	Если Файлы = Неопределено ИЛИ Файлы.Количество() = 0 Тогда Возврат; КонецЕсли;
	Адрес = ПодготовитьНаСервере(ТекущаяДата());
	ПолучитьФайл(Адрес, Файлы[0], Истина);
	Сообщить("Готово: " + Файлы[0]);
КонецПроцедуры

&НаСервере
Функция ПодготовитьНаСервере(Дата)
	УстановитьПривилегированныйРежим(Истина);

	Пакет = Новый Структура;
	Пакет.Вставить("Версия", "1.0");
	Пакет.Вставить("ДатаСреза", Формат(Дата, "ДФ=yyyy-MM-dd"));
	Пакет.Вставить("Конфигурация", "ТранспортныеПеревозки");

	// Для каждого регистра: карта "колонка калькулятора" -> "поле среза" и признак ссылки.
	Пакет.Вставить("ЦеныНаГрузДляКлиентовПоВидамТоваров",
		СрезРег("ЦеныНаГрузДляКлиентовПоВидамТоваров", Дата,
			"клиент:Клиент#, вид_товара:ВидТовара#, тип_упаковки:ТипУпаковки#, склад:Склад#,
			 цена:Цена, экспресс_цена:ЭкспрессЦена, по_весу:ПоВесу, цена_авиа:ЦенаАвиа,
			 авиа_по_объему:АвиаПоОбъему, цена_бренд:ЦенаБренд, цена_z:ЦенаZ, цена_бренд_авиа:ЦенаБрендАвиа,
			 вес_от:ВесОт, вес_до:ВесДо, дата_начала:ДатаНачала, дата_окончания:ДатаОкончания,
			 используется:Используется, период:Период"));

	Пакет.Вставить("ЦеныНаГрузДляКлиентовПоГруппамВидовТоваров",
		СрезРег("ЦеныНаГрузДляКлиентовПоГруппамВидовТоваров", Дата,
			"клиент:Клиент#, группа:Группа#, тип_упаковки:ТипУпаковки#, склад:Склад#,
			 цена:Цена, экспресс_цена:ЭкспрессЦена, по_весу:ПоВесу, цена_авиа:ЦенаАвиа,
			 авиа_по_объему:АвиаПоОбъему, цена_бренд:ЦенаБренд, цена_z:ЦенаZ, цена_бренд_авиа:ЦенаБрендАвиа,
			 вес_от:ВесОт, вес_до:ВесДо, дата_начала:ДатаНачала, дата_окончания:ДатаОкончания,
			 используется:Используется, период:Период"));

	Пакет.Вставить("ЦеныНаГрузПоВидамТовара",
		СрезРег("ЦеныНаГрузПоВидамТовара", Дата,
			"склад:Склад#, вид_товара:ВидТовара#, тип_упаковки:ТипУпаковки#,
			 цена:Цена, экспресс_цена:ЭкспрессЦена, по_весу:ПоВесу, цена_авиа:ЦенаАвиа,
			 авиа_по_объему:АвиаПоОбъему, цена_бренд:ЦенаБренд, цена_z:ЦенаZ, цена_бренд_авиа:ЦенаБрендАвиа,
			 вес_от:ВесОт, вес_до:ВесДо, используется:Используется, период:Период"));

	Пакет.Вставить("КоэффициентыДорожныхРасходов",
		СрезРег("КоэффициентыДорожныхРасходов", Дата,
			"склад:Склад#, коэффициент:Коэффициент, расчет_по_таблице:РасчетПоТаблице, период:Период"));

	Пакет.Вставить("ЦенаДопРасходов",
		СрезРег("ЦенаДопРасходов", Дата,
			"вес_от:ВесОт, вес_до:ВесДо, цена:Цена, по_весу:ПоВесу, период:Период"));

	Пакет.Вставить("тп_ТарифыНаПеревозку",
		СрезРег("тп_ТарифыНаПеревозку", Дата,
			"вид_тарифа:ВидТарифа#, город_отправки:ГородОтправки#, вес_от:ВесОт, вес_до:ВесДо,
			 цена:Цена, по_весу:ПоВесу, период:Период"));

	Пакет.Вставить("тп_ЦеныНаРастаможку",
		СрезРег("тп_ЦеныНаРастаможку", Дата,
			"вид_товара:ВидТовара#, цена:Цена, по_весу:ПоВесу, по_количеству:ПоКоличеству,
			 логистика_включена:ЛогистикаВключена, период:Период"));

	Пакет.Вставить("тп_НаценкиНаТовар",
		СрезРег("тп_НаценкиНаТовар", Дата, "вид_наценки:ВидНаценки#, наценка:Наценка, период:Период"));

	Пакет.Вставить("тп_СтавкиЗаПресс",
		СрезРег("тп_СтавкиЗаПресс", Дата,
			"склад:Склад#, тип_упаковки:ТипУпаковки#, магазин:Магазин#,
			 ставка:Ставка, валюта_ставки:ВалютаСтавки#, период:Период"));

	Пакет.Вставить("Справочник_тп_Склады", ВыгрузитьСклады());

	// Сериализация в JSON
	Запись = Новый ЗаписьJSON;
	ИмяВрем = ПолучитьИмяВременногоФайла("json");
	Запись.ОткрытьФайл(ИмяВрем, , , Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
	ЗаписатьJSON(Запись, Пакет);
	Запись.Закрыть();

	Дв = Новый ДвоичныеДанные(ИмяВрем);
	УдалитьФайлы(ИмяВрем);
	Возврат ПоместитьВоВременноеХранилище(Дв, УникальныйИдентификатор);
КонецФункции

// Универсальный срез последних -> Массив структур с ключами калькулятора.
// КартаПолей: "ключ:Поле[#], ..."  (# = поле-ссылка, выгружается как строка-идентификатор)
&НаСервере
Функция СрезРег(ИмяРегистра, Дата, КартаПолей)
	Пары = Новый Массив;    // [[ключ, поле, ЭтоСсылка], ...]
	Для Каждого Кусок Из СтрРазделить(КартаПолей, ",", Ложь) Цикл
		Кусок = СокрЛП(СтрЗаменить(СтрЗаменить(Кусок, Символы.ПС, ""), Символы.Таб, ""));
		Если ПустаяСтрока(Кусок) Тогда Продолжить; КонецЕсли;
		Ключ = СокрЛП(СтрРазделить(Кусок, ":")[0]);
		Поле = СокрЛП(СтрРазделить(Кусок, ":")[1]);
		ЭтоСсылка = СтрЗаканчиваетсяНа(Поле, "#");
		Поле = СтрЗаменить(Поле, "#", "");
		Пары.Добавить(Новый Структура("ключ,поле,ссылка", Ключ, Поле, ЭтоСсылка));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ * ИЗ РегистрСведений." + ИмяРегистра + ".СрезПоследних(&Дата, ) КАК Т";
	Запрос.УстановитьПараметр("Дата", КонецДня(Дата));
	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Стр = Новый Структура;
		Для Каждого П Из Пары Цикл
			Знач = ?(Выборка.Свойство(П.поле), Выборка[П.поле], Неопределено);
			Стр.Вставить(П.ключ, ЗначениеДляJSON(Знач, П.ссылка));
		КонецЦикла;
		Результат.Добавить(Стр);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ЗначениеДляJSON(Знач, ЭтоСсылка)
	Если Знач = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Знач) = Тип("Дата") Тогда
		Возврат ?(Знач = '00010101', Неопределено, Формат(Знач, "ДФ=yyyy-MM-dd"));
	КонецЕсли;
	Если ТипЗнч(Знач) = Тип("Булево") ИЛИ ТипЗнч(Знач) = Тип("Число") Тогда
		Возврат Знач;
	КонецЕсли;
	Если ЭтоСсылка Тогда
		Если НЕ ЗначениеЗаполнено(Знач) Тогда Возврат Неопределено; КонецЕсли;
		// Идентификатор: Код (справочники) либо имя (перечисления)
		Попытка
			Если Знач.Метаданные().Реквизиты.Найти("Код") <> Неопределено
				ИЛИ СтрНайти(Знач.Метаданные().ПолноеИмя(), "Справочник") > 0 Тогда
				Возврат СокрЛП(Знач.Код);
			КонецЕсли;
		Исключение
		КонецПопытки;
		Возврат СокрЛП(Строка(Знач));   // перечисления и пр.
	КонецЕсли;
	Возврат Строка(Знач);
КонецФункции

&НаСервере
Функция ВыгрузитьСклады()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Код, Наименование, ТолькоСвоиЦены, ГородОтправки
	               |ИЗ Справочник.тп_Склады ГДЕ НЕ ПометкаУдаления";
	Массив = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		С = Новый Структура;
		С.Вставить("ид", СокрЛП(Выборка.Код));         // тот же идентификатор, что в ценах
		С.Вставить("код", СокрЛП(Выборка.Код));
		С.Вставить("наименование", Выборка.Наименование);
		С.Вставить("город_отправки", ?(Выборка.Свойство("ГородОтправки"), Строка(Выборка.ГородОтправки), ""));
		С.Вставить("только_свои_цены", ?(Выборка.Свойство("ТолькоСвоиЦены"), Выборка.ТолькоСвоиЦены, Ложь));
		Массив.Добавить(С);
	КонецЦикла;
	Возврат Массив;
КонецФункции
